# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Comments sit on their own lines: an inline comment after an empty value is
# read as the value. Save the file as UTF-8.
# Every setting the code reads is listed here, in the order of oversight/settings.py.
# Values shown are what this project runs with. Fill in the secrets (JIRA_EMAIL,
# JIRA_API_TOKEN, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, API_SERVICE_KEY); other blanks can stay empty.

# ── Jira (read-only) ──
# Until the client's read-only service account arrives, use your own API token
# (https://id.atlassian.com/manage-profile/security/api-tokens). The client's
# endpoint allowlist keeps every call read-only either way. Must be https://.
JIRA_BASE_URL=https://stellaint.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated project keys: the boards the scheduled cycle always keeps in sync.
# The first is the dashboard's default board. A board with no entry in
# config/process.yaml is mapped from Jira's status categories.
JIRA_PROJECTS=AIL,LEADRSCOMS,LEADRSDRE
# on: the dashboard also lists every other board this Jira account can browse (a
# read-only project search); a board syncs the first time someone presses Sync on it,
# and the cycle keeps it fresh from then on. off: JIRA_PROJECTS only.
BOARD_DISCOVERY=on

# ── storage ──
# Relative paths resolve against the project folder.
DB_PATH=data/oversight.db

# ── reporting ──
# The organisation's reporting time zone, an IANA name such as America/Chicago:
# report days, digest dates, the insights week. Blank: UTC.
REPORT_TIMEZONE=

# ── LLM (Ask and the weekly insights) ──
# stub: answers are composed from the data by the scripted provider, no key
# needed (demos, CI). live: Claude through LLM_PROVIDER.
LLM_MODE=live
# anthropic: the Claude API (ANTHROPIC_API_KEY). bedrock: Claude on Amazon Bedrock (AWS_* below).
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
# First-party ids; on Bedrock the anthropic. prefix is added for you. Bedrock in
# us-east-1 offers claude-opus-5-5 but not claude-sonnet-5-5: use claude-opus-5-5 for both there.
LLM_MODEL_QA=claude-opus-5-5
LLM_MODEL_INSIGHTS=claude-opus-5-5
LLM_TIMEOUT_S=60
# Server-side refusal fallbacks on text calls (true | false). Claude API only; ignored on Bedrock.
LLM_FALLBACKS=true
# analyst: with a live model, Claude answers any question by querying a read-only copy
# of the data. catalog: only the fixed lookups. LLM_MODE=stub always uses the catalogue.
ASK_MODE=analyst

# ── Amazon Bedrock (LLM_PROVIDER=bedrock) ──
# Use an IAM identity limited to invoking Bedrock models. On an AWS host, leave the
# keys blank and give the host a role: the standard AWS credential chain is used.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# ── notifications (daily digest) ──
# file | email | teams. file writes reports/digests/<project>_<date>.md.
DIGEST_CHANNEL=email
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients.
DIGEST_TO=
# A Teams Workflows webhook URL (used when DIGEST_CHANNEL=teams).
TEAMS_WEBHOOK_URL=

# ── dashboard API ──
API_HOST=127.0.0.1
API_PORT=3300
# run.py only: restart when a source file changes (development, never production).
API_RELOAD=false
# Interactive docs at /docs (Authorize with API_SERVICE_KEY). Local use only.
API_DOCS=false
# The UI's server route presents this key: it must equal OVERSIGHT_SERVICE_KEY in
# jira-oversight-ui/.env.local. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_KEY=
# Permits a blank API_SERVICE_KEY for a local demo only.
API_ALLOW_INSECURE=false
CORS_ALLOW_ORIGINS=http://localhost:3400
# on | off. Set it to off only if the organisation does not want people compared.
PEOPLE_COMPARISON=on

# ── governance ──
# Days the access log (who viewed whose figures) keeps an entry; at least 30.
ACCESS_LOG_DAYS=365
# Questions each viewer may ask in a window, such as 30/10m (30 in any 10 minutes); off: no limit.
ASK_RATE_LIMIT=off
# Model tokens (input + output) per UTC day across Ask and insights; 0: no limit.
LLM_DAILY_TOKEN_BUDGET=0

# ── deployment (docs/DEPLOYMENT.md) ──
# `python -m oversight backup` keeps this many of its newest backups (data/backups); at least 1.
BACKUP_KEEP=14
# `python -m oversight cycle --loop` (the sync service): minutes between cycles, 5 to 1440.
SYNC_INTERVAL_MINUTES=60

# ── logging ──
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# ── advanced (the defaults are fine) ──
# Jira: timeouts in seconds, attempts per request (only 429, 5xx and network
# errors are retried) and page size.
JIRA_TIMEOUT_S=30
JIRA_CONNECT_TIMEOUT_S=5
JIRA_MAX_ATTEMPTS=4
JIRA_PAGE_SIZE=100
# Folders: config/ holds process.yaml, fields.yaml and rules.yaml; reports/ the digests.
CONFIG_DIR=config
REPORTS_DIR=reports
LLM_MAX_RETRIES=2
# Ask: catalogue calls per question and rows per call; the analyst's tool turns per question.
ASK_MAX_CALLS=3
ASK_ROW_LIMIT=200
ASK_MAX_STEPS=6
# Seed for the generated DEMO project.
DEMO_SEED=20261104
