# Copy to .env and fill in. Keep comments on their own line; never commit .env.

# Jira (read-only)
JIRA_BASE_URL=https://stellaint.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Boards always kept in sync; the first is the default board.
JIRA_PROJECTS=AIL,LEADRSCOMS,LEADRSDRE
# on: also list every other board the Jira account can browse.
BOARD_DISCOVERY=on

# Storage
DB_PATH=data/oversight.db

# Reporting time zone (IANA name, e.g. America/Chicago). Blank: UTC.
REPORT_TIMEZONE=

# AI (Ask and weekly insights)
# stub: no model, answers built from the data. live: Claude through LLM_PROVIDER.
LLM_MODE=live
# anthropic (ANTHROPIC_API_KEY) or bedrock (AWS settings below).
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
LLM_MODEL_QA=claude-opus-5-5
LLM_MODEL_INSIGHTS=claude-opus-5-5
LLM_TIMEOUT_S=60
# Refusal fallbacks; Claude API only.
LLM_FALLBACKS=true
# analyst: Claude queries a read-only copy of the data. catalog: fixed lookups only.
ASK_MODE=analyst

# Amazon Bedrock (leave the keys blank on an AWS host with an IAM role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Daily digest: file, email or teams
DIGEST_CHANNEL=email
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients.
DIGEST_TO=
TEAMS_WEBHOOK_URL=

# Dashboard API
API_HOST=127.0.0.1
API_PORT=3300
# Development only: restart on code changes.
API_RELOAD=false
# Interactive docs at /docs; local use only.
API_DOCS=false
# Same value as OVERSIGHT_SERVICE_KEY in the dashboard. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_KEY=
# Allows a blank API_SERVICE_KEY; local demos only.
API_ALLOW_INSECURE=false
CORS_ALLOW_ORIGINS=http://localhost:3400
PEOPLE_COMPARISON=on

# Governance
# Days to keep access log entries (at least 30).
ACCESS_LOG_DAYS=365
# Questions per viewer per window, e.g. 30/10m. off: no limit.
ASK_RATE_LIMIT=off
# Model tokens per UTC day. 0: no limit.
LLM_DAILY_TOKEN_BUDGET=0

# Operations
BACKUP_KEEP=14
# Minutes between sync cycles (5 to 1440).
SYNC_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Advanced (the defaults are fine)
JIRA_TIMEOUT_S=30
JIRA_CONNECT_TIMEOUT_S=5
JIRA_MAX_ATTEMPTS=4
JIRA_PAGE_SIZE=100
CONFIG_DIR=config
REPORTS_DIR=reports
LLM_MAX_RETRIES=2
ASK_MAX_CALLS=3
ASK_ROW_LIMIT=200
ASK_MAX_STEPS=6
DEMO_SEED=20261104
