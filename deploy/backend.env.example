# Production settings for the API, the sync service and the admin commands (docs/DEPLOYMENT.md, step 5).
# Copy to deploy/backend.env and make it readable by you only (chmod 600). Never commit the copy.
# Every value here is safe to start from: a blank must be filled in, and nothing is filled in for you that belongs
# to a development machine (a site, a board, a region, a mail server). Comments sit on their own lines: an inline
# comment after an empty value is read as the value.
# The compose file sets API_HOST, API_PORT, API_RELOAD, DB_PATH, CONFIG_DIR and REPORTS_DIR itself.

# ── Jira (read-only) ──
# The client's site (https), the sync account (Browse Projects on the boards, nothing more) and its API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated board keys, each mapped in config/process.yaml.
JIRA_PROJECTS=

# ── reporting ──
# The organisation's zone, such as Europe/London or America/New_York. Blank: UTC, and the doctor warns.
REPORT_TIMEZONE=

# ── the AI model (step 1.6) ──
# stub: every answer is built in code; no model is called and nothing leaves the server. Set live only once the
# client has agreed the provider and the region.
LLM_MODE=stub
# anthropic (ANTHROPIC_API_KEY) or bedrock (the AWS settings below).
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
LLM_MODEL_QA=claude-opus-5-5
LLM_MODEL_INSIGHTS=claude-opus-5-5
ASK_MODE=analyst
# Bedrock: the region the client agreed (US, UK or EU), where Ask's questions, people's figures among them, are
# processed. Leave the keys blank on an AWS host with a role; on EC2 the containers then need an instance-metadata
# hop limit of 2 or more to reach it (the doctor warns).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# ── the daily digest (the cron line in step 6.9) ──
# file writes reports/digests/<board>_<date>.md on the reports volume and needs nothing else. email needs
# SMTP_HOST, SMTP_FROM and DIGEST_TO; teams needs TEAMS_WEBHOOK_URL.
DIGEST_CHANNEL=file
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=
TEAMS_WEBHOOK_URL=

# ── the API ──
# 64 random characters (step 5.2); the dashboard's OVERSIGHT_SERVICE_KEY is the same value.
API_SERVICE_KEY=
API_ALLOW_INSECURE=false
API_DOCS=false
# The web address people open, such as https://oversight.example.com.
CORS_ALLOW_ORIGINS=
# on | off: set it to off only if the client does not want people compared (step 1.5).
PEOPLE_COMPARISON=on

# ── governance ──
# Days the access log keeps an entry, at least 30: ask the client's data protection officer.
ACCESS_LOG_DAYS=365
# Questions each viewer may ask in a window, such as 30/10m; off: no limit.
ASK_RATE_LIMIT=off
# Model tokens (input + output) per UTC day across Ask and insights; 0: no limit.
LLM_DAILY_TOKEN_BUDGET=0

# ── the sync service and backups ──
SYNC_INTERVAL_MINUTES=60
BACKUP_KEEP=14

# ── logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
