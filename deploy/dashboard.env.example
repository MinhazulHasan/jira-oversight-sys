# Production settings for the dashboard (docs/DEPLOYMENT.md, step 5).
# Copy to deploy/dashboard.env and make it readable by you only (chmod 600). Never commit the copy.
# Every blank must be filled in. Nothing is filled in for you: until ALLOWED_EMAIL_DOMAINS and ADMIN_EMAILS name the
# client's own, nobody can sign in and nobody is an admin. Comments sit on their own lines: an inline comment after
# an empty value is read as the value.
# The compose file sets OVERSIGHT_DATA=live, OVERSIGHT_API_URL and AUTH_MODE=atlassian itself (sign-in is always on).

# The same value as API_SERVICE_KEY in deploy/backend.env.
OVERSIGHT_SERVICE_KEY=
# The client's Jira site, such as https://your-site.atlassian.net.
OVERSIGHT_JIRA_BASE_URL=
# The address people open: https, origin only, such as https://oversight.example.com. Blank: /login names it as
# missing and nobody gets in.
APP_URL=
# The production Atlassian app's (step 4), never the development one's.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# At least 32 random characters (step 5.2), used nowhere else. Changing it signs everyone out and starts new viewer
# ids in the access log: export the log first (step 5.5).
AUTH_SECRET=
# The client's email domains only, comma-separated.
ALLOWED_EMAIL_DOMAINS=
# The client's admins, comma-separated, each on one of those domains.
ADMIN_EMAILS=

# Tests and the bundled sample only: leave every one of these empty.
ATLASSIAN_AUTH_URL=
ATLASSIAN_API_URL=
SAMPLE_NOW=
SAMPLE_LATENCY=
SAMPLE_PEOPLE_COMPARISON=
