# Production settings for the dashboard (Docker). Copy to deploy/dashboard.env; never commit the copy.
# Keep comments on their own line. The compose file sets OVERSIGHT_DATA, OVERSIGHT_API_URL and AUTH_MODE.

# Same value as API_SERVICE_KEY in deploy/backend.env.
OVERSIGHT_SERVICE_KEY=
# Jira site, e.g. https://your-site.atlassian.net.
OVERSIGHT_JIRA_BASE_URL=
# Public address (https, origin only), e.g. https://oversight.example.com.
APP_URL=
# Production Atlassian app credentials.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# At least 32 random characters. Changing it signs everyone out.
AUTH_SECRET=
# Comma-separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=
# Comma-separated admin emails.
ADMIN_EMAILS=

# Tests and sample only: leave empty.
ATLASSIAN_AUTH_URL=
ATLASSIAN_API_URL=
SAMPLE_NOW=
SAMPLE_LATENCY=
SAMPLE_PEOPLE_COMPARISON=
