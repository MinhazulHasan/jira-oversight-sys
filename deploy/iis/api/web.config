<?xml version="1.0" encoding="utf-8"?>
<!-- The API's IIS site: uvicorn behind HttpPlatformHandler; the installer fills in the placeholders. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="__PYTHON__"
                  arguments="-m oversight api --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__API_LOGS__\stdout"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:02:00"
                  processesPerApplication="1"
                  rapidFailsPerMinute="10"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="__BACKEND__" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONDONTWRITEBYTECODE" value="1" />
      </environmentVariables>
    </httpPlatform>

    <!-- The API's JSON errors (401, 404, 409 and the rest) reach the dashboard as they are, never replaced by IIS's. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" maxQueryString="8192" />
      </requestFiltering>
    </security>

    <webSocket enabled="false" />
  </system.webServer>
</configuration>
