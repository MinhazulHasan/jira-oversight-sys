<?xml version="1.0" encoding="utf-8"?>
<!--
  The API's IIS site: uvicorn (python -m oversight api) behind HttpPlatformHandler, reachable on this machine only.
  docs/DEPLOYMENT_IIS.md walks through it. Install-JiraOversight.ps1 fills in the placeholders (words between double
  underscores) and writes the result to the site's folder; edit that copy only for a value the installer has no
  parameter for, and keep this file as it is.

  How it runs: IIS starts one python.exe, hands it a free loopback port in HTTP_PLATFORM_PORT, and forwards every request
  to it (the port in the arguments below). The site itself is bound to 127.0.0.1 only (the installer's -ApiPort), so
  the dashboard reaches it and nobody else does. The app pool is "No Managed Code".

  Settings: the API reads the backend's own .env (from the .env.example template: oversight/settings.py loads it from
  the project folder, whatever the working folder is). They are never in this file. PYTHONPATH is how python finds the
  oversight package, as IIS starts the process in the site's folder, not the project's.

  Security headers: none are added here. The API sends Cache-Control: no-store and X-Content-Type-Options: nosniff on
  every response itself, and no browser opens it. This file only removes the two banners IIS would add.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!--
      startupTimeLimit: seconds IIS waits for the first answer; the API brings an older snapshot to this release's schema
      before it listens, which takes longer on a big one. requestTimeout: Ask can take a minute with a live model. One
      process only: a second one would share the snapshot and split the Ask rate limit's count.
    -->
    <httpPlatform processPath="__PYTHON__"
                  arguments="-m oversight api --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__API_LOGS__\stdout"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:02:00"
                  processesPerApplication="1"
                  rapidFailsPerMinute="10"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="__BACKEND__" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONDONTWRITEBYTECODE" value="1" />
      </environmentVariables>
    </httpPlatform>

    <!-- The API's JSON errors (401, 404, 409 and the rest) reach the dashboard as they are, never replaced by IIS's. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" maxQueryString="8192" />
      </requestFiltering>
    </security>

    <webSocket enabled="false" />
  </system.webServer>
</configuration>
