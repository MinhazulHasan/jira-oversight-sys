# Production settings for the API and scheduled tasks on IIS (docs/DEPLOYMENT_IIS.md, section 7).
# The installer copies this to .env. Fill in every blank, never commit the copy, keep comments on their own line.

# Jira (dedicated read-only account)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated board keys always kept in sync; the first is the default board.
JIRA_PROJECTS=
# Uncomment and set to off to show only JIRA_PROJECTS.
# BOARD_DISCOVERY=on

# Reporting time zone, e.g. Europe/London. Blank: UTC.
REPORT_TIMEZONE=

# AI: stub (no model) or live.
LLM_MODE=stub
# anthropic or bedrock.
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
LLM_MODEL_QA=claude-opus-5-5
LLM_MODEL_INSIGHTS=claude-opus-5-5
ASK_MODE=analyst
# Bedrock region agreed with the client. Leave the keys blank on an AWS host with a role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Daily digest: file, email (SMTP_*, DIGEST_TO) or teams (TEAMS_WEBHOOK_URL).
DIGEST_CHANNEL=file
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=
TEAMS_WEBHOOK_URL=

# API
# 64 random characters; same value as the dashboard's OVERSIGHT_SERVICE_KEY.
API_SERVICE_KEY=
API_ALLOW_INSECURE=false
API_DOCS=false
# Where admin commands reach the API site (IIS gives the process its own port).
API_HOST=127.0.0.1
API_PORT=3300
# The public web address, e.g. https://oversight.example.com.
CORS_ALLOW_ORIGINS=
PEOPLE_COMPARISON=on

# Governance
# Days to keep access log entries (at least 30).
ACCESS_LOG_DAYS=365
# Questions per viewer per window, e.g. 30/10m. off: no limit.
ASK_RATE_LIMIT=off
# Model tokens per UTC day. 0: no limit.
LLM_DAILY_TOKEN_BUDGET=0

# Backups kept in data\backups.
BACKUP_KEEP=14

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
