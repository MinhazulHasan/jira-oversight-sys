# Production settings for the API, the scheduled sync and the admin commands on IIS (docs/DEPLOYMENT_IIS.md, section 7).
# The installer copies this to .env in the backend's folder when there is none, and limits who can read it. Fill in
# every blank. Never commit the copy, never paste it into a ticket or a chat, and save it as UTF-8.
# Nothing here is filled in for you that belongs to a development machine (a site, a board, a region, a mail server).
# Comments sit on their own lines: an inline comment after an empty value is read as the value.
# The API's port is not set here: IIS gives the process its own (HttpPlatformHandler). API_PORT below is only where
# `python -m oversight.healthcheck` and the admin commands find the API site.

# --- Jira (read-only) ---
# The client's site (https), a dedicated read-only account (never a person's: section 6) and its API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated board keys the scheduled sync always keeps fresh, each mapped in config/process.yaml. The first is
# the default board.
JIRA_PROJECTS=
# With board discovery (on by default) every board the account can browse is listed in the dashboard; this key
# turns it off, leaving JIRA_PROJECTS only. Uncomment to change it.
# BOARD_DISCOVERY=on

# --- reporting ---
# The organisation's zone, such as Europe/London or America/New_York. Blank: UTC, and the doctor warns.
REPORT_TIMEZONE=

# --- the AI model ---
# stub: every answer is built in code; no model is called and nothing leaves the server. Set live only once the
# client has agreed the provider and the region.
LLM_MODE=stub
# anthropic (ANTHROPIC_API_KEY) or bedrock (the AWS settings below).
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
LLM_MODEL_QA=claude-opus-5-5
LLM_MODEL_INSIGHTS=claude-opus-5-5
ASK_MODE=analyst
# Bedrock: the region the client agreed (US, UK or EU), where Ask's questions, people's figures among them, are
# processed. On an EC2 or other AWS host with a role, leave the keys blank: the host's role is used, and the app pool
# reaches it like any process on the host. Elsewhere, set the keys of an IAM user that may only invoke Bedrock models.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- the daily digest (optional: scripts/morning.ps1) ---
# file writes reports\digests\<board>_<date>.md and needs nothing else. email needs SMTP_HOST, SMTP_FROM and DIGEST_TO;
# teams needs TEAMS_WEBHOOK_URL.
DIGEST_CHANNEL=file
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=
TEAMS_WEBHOOK_URL=

# --- the API ---
# 64 random characters (section 7); the dashboard's OVERSIGHT_SERVICE_KEY is the same value.
API_SERVICE_KEY=
API_ALLOW_INSECURE=false
API_DOCS=false
# Where the admin commands look for the API site: the loopback address and port the installer binds it to (-ApiPort).
API_HOST=127.0.0.1
API_PORT=3300
# The web address people open, such as https://oversight.example.com (the dashboard calls the API from its server, so
# this is not otherwise used).
CORS_ALLOW_ORIGINS=
# on | off: set it to off only if the client does not want people compared.
PEOPLE_COMPARISON=on

# --- governance ---
# Days the access log keeps an entry, at least 30: ask the client's data protection officer.
ACCESS_LOG_DAYS=365
# Questions each viewer may ask in a window, such as 30/10m; off: no limit.
ASK_RATE_LIMIT=off
# Model tokens (input + output) per UTC day across Ask and insights; 0: no limit.
LLM_DAILY_TOKEN_BUDGET=0

# --- backups ---
# The daily backup task keeps this many of its newest files in data\backups.
BACKUP_KEEP=14

# --- logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
