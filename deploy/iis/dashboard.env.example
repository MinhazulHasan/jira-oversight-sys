# Production settings for the dashboard on IIS (docs/DEPLOYMENT_IIS.md, section 7).
# The installer copies this to dashboard.env. Fill in every blank, never commit the copy, keep comments on their own line.
# Values must not contain # or quotes. web.config sets OVERSIGHT_DATA, OVERSIGHT_API_URL and AUTH_MODE.

# Same value as API_SERVICE_KEY in the backend's .env.
OVERSIGHT_SERVICE_KEY=
# Jira site, e.g. https://your-site.atlassian.net.
OVERSIGHT_JIRA_BASE_URL=
# Public address (https, origin only); the installer's -HostName.
APP_URL=
# Production Atlassian app credentials.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# At least 32 random characters. Changing it signs everyone out.
AUTH_SECRET=
# Comma-separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=

# Everyone who signs in is an admin. To limit admins, uncomment both lines.
# ACCESS_MODE=admin-list
# ADMIN_EMAILS=

# Tests and sample only: leave empty.
ATLASSIAN_AUTH_URL=
ATLASSIAN_API_URL=
SAMPLE_NOW=
SAMPLE_LATENCY=
SAMPLE_PEOPLE_COMPARISON=
