<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard's IIS site: the Next.js standalone server behind HttpPlatformHandler; the installer fills in the placeholders. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="__NODE__"
                  arguments="--env-file=&quot;__DASHBOARD_ENV__&quot; &quot;__DASHBOARD_APP__\server.js&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__DASHBOARD_LOGS__\stdout"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:02:30"
                  processesPerApplication="1"
                  rapidFailsPerMinute="10"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="NEXT_TELEMETRY_DISABLED" value="1" />
        <environmentVariable name="OVERSIGHT_DATA" value="live" />
        <environmentVariable name="OVERSIGHT_API_URL" value="http://127.0.0.1:__API_PORT__" />
        <environmentVariable name="AUTH_MODE" value="atlassian" />
      </environmentVariables>
    </httpPlatform>

    <!-- The app's own error pages and JSON errors reach the browser as they are, never replaced by IIS's. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" maxQueryString="8192" />
      </requestFiltering>
    </security>

    <webSocket enabled="false" />

    <!-- Plain http goes to https on the one address people use, except win-acme's challenge (URL Rewrite module). -->
    <rewrite>
      <rules>
        <rule name="Redirect to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://__HOST_NAME__/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
