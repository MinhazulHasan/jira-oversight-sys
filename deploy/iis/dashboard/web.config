<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard's IIS site: the Next.js standalone server (server.js) behind HttpPlatformHandler.
  docs/DEPLOYMENT_IIS.md walks through it. Install-JiraOversight.ps1 fills in the placeholders (words between double
  underscores) and writes the result to the site's folder; edit that copy only for a value the installer has no
  parameter for, and keep this file as it is.

  How it runs: IIS starts one node.exe, hands it a free loopback port in HTTP_PLATFORM_PORT (the server reads PORT), and
  forwards every request to it. The server binds 127.0.0.1 only. The app pool is "No Managed Code".

  Settings: the secrets and the client's own values are in the dashboard's env file, which node reads at start
  (node's env-file option, from the dashboard.env.example template). They are never in this file. The values below
  are this stack's wiring: an environment variable wins over the env file, so no edit of that file can change them.

  Security headers: none are added here. The dashboard sends its own on every response (Content-Security-Policy,
  Strict-Transport-Security, X-Frame-Options, Referrer-Policy and the rest: next.config.ts, src/proxy.ts), and a second
  copy at IIS would fight them. This file only removes the two banners IIS would add.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!--
      startupTimeLimit: seconds IIS waits for the first answer. requestTimeout: Ask can take a minute with a live model,
      and the API's own limit (2 minutes) must end first. One process only: the app keeps state in its memory.
    -->
    <httpPlatform processPath="__NODE__"
                  arguments="--env-file=&quot;__DASHBOARD_ENV__&quot; &quot;__DASHBOARD_APP__\server.js&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__DASHBOARD_LOGS__\stdout"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:02:30"
                  processesPerApplication="1"
                  rapidFailsPerMinute="10"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="NEXT_TELEMETRY_DISABLED" value="1" />
        <environmentVariable name="OVERSIGHT_DATA" value="live" />
        <environmentVariable name="OVERSIGHT_API_URL" value="http://127.0.0.1:__API_PORT__" />
        <environmentVariable name="AUTH_MODE" value="atlassian" />
      </environmentVariables>
    </httpPlatform>

    <!-- The app's own error pages and JSON errors reach the browser as they are, never replaced by IIS's. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" maxQueryString="8192" />
      </requestFiltering>
    </security>

    <webSocket enabled="false" />

    <!-- Plain http goes to https on the one address people use (the URL Rewrite module). -->
    <rewrite>
      <rules>
        <rule name="Redirect to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://__HOST_NAME__/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
